{
  "name": "@devdigest/mcp",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "DevDigest MCP server (stdio). Reaches DevDigest only through its HTTP API on :3001.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "tsx --tsconfig tsconfig.json src/index.ts",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs --output-type err"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.32.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^17.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
